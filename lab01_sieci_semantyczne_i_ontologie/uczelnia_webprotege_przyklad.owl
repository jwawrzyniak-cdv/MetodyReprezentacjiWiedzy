<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/uczelnia#"
     xml:base="urn:webprotege:ontology:3f6c2a1e-8b7d-4c59-9e0a-5d2b7c41a9f0"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:u="http://example.org/uczelnia#">
    <owl:Ontology rdf:about="urn:webprotege:ontology:3f6c2a1e-8b7d-4c59-9e0a-5d2b7c41a9f0">
        <rdfs:comment xml:lang="pl">Plik przykładowy do laboratorium 1. Przygotowany ręcznie w układzie eksportu RDF/XML z WebProtégé (nie jest zapisem rzeczywistej sesji). Odpowiada stanowi po scenariuszach W1 do W3.</rdfs:comment>
    </owl:Ontology>



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->



    <!-- http://example.org/uczelnia#autor -->

    <owl:ObjectProperty rdf:about="http://example.org/uczelnia#autor">
        <rdfs:domain rdf:resource="http://example.org/uczelnia#PracaDyplomowa"/>
        <rdfs:range rdf:resource="http://example.org/uczelnia#Student"/>
        <rdfs:label xml:lang="pl">autor</rdfs:label>
        <rdfs:label xml:lang="en">author</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://example.org/uczelnia#naWydziale -->

    <owl:ObjectProperty rdf:about="http://example.org/uczelnia#naWydziale">
        <rdfs:range rdf:resource="http://example.org/uczelnia#Wydzial"/>
        <rdfs:label xml:lang="pl">na wydziale</rdfs:label>
        <rdfs:label xml:lang="en">in faculty</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://example.org/uczelnia#promotor -->

    <owl:ObjectProperty rdf:about="http://example.org/uczelnia#promotor">
        <rdfs:domain rdf:resource="http://example.org/uczelnia#PracaDyplomowa"/>
        <rdfs:range rdf:resource="http://example.org/uczelnia#Pracownik"/>
        <rdfs:label xml:lang="pl">promotor</rdfs:label>
        <rdfs:label xml:lang="en">supervisor</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://example.org/uczelnia#prowadzi -->

    <owl:ObjectProperty rdf:about="http://example.org/uczelnia#prowadzi">
        <owl:inverseOf rdf:resource="http://example.org/uczelnia#prowadzonyPrzez"/>
        <rdfs:domain rdf:resource="http://example.org/uczelnia#Pracownik"/>
        <rdfs:range rdf:resource="http://example.org/uczelnia#Kurs"/>
        <rdfs:label xml:lang="pl">prowadzi</rdfs:label>
        <rdfs:label xml:lang="en">teaches</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://example.org/uczelnia#prowadzonyPrzez -->

    <owl:ObjectProperty rdf:about="http://example.org/uczelnia#prowadzonyPrzez">
        <rdfs:label xml:lang="pl">prowadzony przez</rdfs:label>
        <rdfs:label xml:lang="en">taught by</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://example.org/uczelnia#wymagaKursu -->

    <owl:ObjectProperty rdf:about="http://example.org/uczelnia#wymagaKursu">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://example.org/uczelnia#Kurs"/>
        <rdfs:range rdf:resource="http://example.org/uczelnia#Kurs"/>
        <rdfs:label xml:lang="pl">wymaga kursu</rdfs:label>
        <rdfs:label xml:lang="en">requires course</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://example.org/uczelnia#zaliczyl -->

    <owl:ObjectProperty rdf:about="http://example.org/uczelnia#zaliczyl">
        <rdfs:domain rdf:resource="http://example.org/uczelnia#Student"/>
        <rdfs:range rdf:resource="http://example.org/uczelnia#Kurs"/>
        <rdfs:label xml:lang="pl">zaliczył</rdfs:label>
        <rdfs:label xml:lang="en">passed</rdfs:label>
    </owl:ObjectProperty>


    <!-- http://example.org/uczelnia#zapisanyNa -->

    <owl:ObjectProperty rdf:about="http://example.org/uczelnia#zapisanyNa">
        <rdfs:domain rdf:resource="http://example.org/uczelnia#Student"/>
        <rdfs:range rdf:resource="http://example.org/uczelnia#Kurs"/>
        <rdfs:label xml:lang="pl">zapisany na</rdfs:label>
        <rdfs:label xml:lang="en">enrolled in</rdfs:label>
    </owl:ObjectProperty>



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->



    <!-- http://example.org/uczelnia#ects -->

    <owl:DatatypeProperty rdf:about="http://example.org/uczelnia#ects">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/uczelnia#Kurs"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pl">punkty ECTS</rdfs:label>
        <rdfs:label xml:lang="en">ECTS credits</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://example.org/uczelnia#imie -->

    <owl:DatatypeProperty rdf:about="http://example.org/uczelnia#imie">
        <rdfs:domain rdf:resource="http://example.org/uczelnia#Osoba"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pl">imię</rdfs:label>
        <rdfs:label xml:lang="en">first name</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://example.org/uczelnia#nazwisko -->

    <owl:DatatypeProperty rdf:about="http://example.org/uczelnia#nazwisko">
        <rdfs:domain rdf:resource="http://example.org/uczelnia#Osoba"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="pl">nazwisko</rdfs:label>
        <rdfs:label xml:lang="en">last name</rdfs:label>
    </owl:DatatypeProperty>


    <!-- http://example.org/uczelnia#rokStudiow -->

    <owl:DatatypeProperty rdf:about="http://example.org/uczelnia#rokStudiow">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/uczelnia#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="pl">rok studiów</rdfs:label>
        <rdfs:label xml:lang="en">year of study</rdfs:label>
    </owl:DatatypeProperty>



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->



    <!-- http://example.org/uczelnia#Kurs -->

    <owl:Class rdf:about="http://example.org/uczelnia#Kurs">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/uczelnia#naWydziale"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/uczelnia#Wydzial"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="pl">Kurs</rdfs:label>
        <rdfs:label xml:lang="en">Course</rdfs:label>
        <rdfs:comment xml:lang="pl">Zajęcia z przypisaną liczbą punktów ECTS.</rdfs:comment>
        <rdfs:comment xml:lang="en">A unit of teaching with ECTS credits.</rdfs:comment>
    </owl:Class>


    <!-- http://example.org/uczelnia#KursObieralny -->

    <owl:Class rdf:about="http://example.org/uczelnia#KursObieralny">
        <rdfs:subClassOf rdf:resource="http://example.org/uczelnia#Kurs"/>
        <rdfs:label xml:lang="pl">Kurs obieralny</rdfs:label>
        <rdfs:label xml:lang="en">Elective course</rdfs:label>
    </owl:Class>


    <!-- http://example.org/uczelnia#KursObowiazkowy -->

    <owl:Class rdf:about="http://example.org/uczelnia#KursObowiazkowy">
        <rdfs:subClassOf rdf:resource="http://example.org/uczelnia#Kurs"/>
        <owl:disjointWith rdf:resource="http://example.org/uczelnia#KursObieralny"/>
        <rdfs:label xml:lang="pl">Kurs obowiązkowy</rdfs:label>
        <rdfs:label xml:lang="en">Mandatory course</rdfs:label>
    </owl:Class>


    <!-- http://example.org/uczelnia#Osoba -->

    <owl:Class rdf:about="http://example.org/uczelnia#Osoba">
        <rdfs:label xml:lang="pl">Osoba</rdfs:label>
        <rdfs:label xml:lang="en">Person</rdfs:label>
        <rdfs:comment xml:lang="pl">Człowiek związany z uczelnią.</rdfs:comment>
        <rdfs:comment xml:lang="en">A person affiliated with the university.</rdfs:comment>
    </owl:Class>


    <!-- http://example.org/uczelnia#PracaDyplomowa -->

    <owl:Class rdf:about="http://example.org/uczelnia#PracaDyplomowa">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/uczelnia#autor"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/uczelnia#Student"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/uczelnia#promotor"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/uczelnia#Pracownik"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="pl">Praca dyplomowa</rdfs:label>
        <rdfs:label xml:lang="en">Thesis</rdfs:label>
    </owl:Class>


    <!-- http://example.org/uczelnia#Pracownik -->

    <owl:Class rdf:about="http://example.org/uczelnia#Pracownik">
        <rdfs:subClassOf rdf:resource="http://example.org/uczelnia#Osoba"/>
        <rdfs:label xml:lang="pl">Pracownik</rdfs:label>
        <rdfs:label xml:lang="en">Employee</rdfs:label>
        <rdfs:comment xml:lang="pl">Osoba zatrudniona na uczelni.</rdfs:comment>
        <rdfs:comment xml:lang="en">A person employed by the university.</rdfs:comment>
    </owl:Class>


    <!-- http://example.org/uczelnia#Student -->

    <owl:Class rdf:about="http://example.org/uczelnia#Student">
        <rdfs:subClassOf rdf:resource="http://example.org/uczelnia#Osoba"/>
        <owl:disjointWith rdf:resource="http://example.org/uczelnia#Pracownik"/>
        <rdfs:label xml:lang="pl">Student</rdfs:label>
        <rdfs:label xml:lang="en">Student</rdfs:label>
        <rdfs:comment xml:lang="pl">Osoba studiująca na uczelni.</rdfs:comment>
        <rdfs:comment xml:lang="en">A person studying at the university.</rdfs:comment>
    </owl:Class>


    <!-- http://example.org/uczelnia#Wydzial -->

    <owl:Class rdf:about="http://example.org/uczelnia#Wydzial">
        <rdfs:label xml:lang="pl">Wydział</rdfs:label>
        <rdfs:label xml:lang="en">Faculty</rdfs:label>
    </owl:Class>


    <!-- http://example.org/uczelnia#Wykladowca -->

    <owl:Class rdf:about="http://example.org/uczelnia#Wykladowca">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/uczelnia#Pracownik"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/uczelnia#prowadzi"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/uczelnia#Kurs"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://example.org/uczelnia#Pracownik"/>
        <rdfs:label xml:lang="pl">Wykładowca</rdfs:label>
        <rdfs:label xml:lang="en">Lecturer</rdfs:label>
        <rdfs:comment xml:lang="pl">Pracownik, który prowadzi co najmniej jeden kurs.</rdfs:comment>
        <rdfs:comment xml:lang="en">An employee who teaches at least one course.</rdfs:comment>
    </owl:Class>



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->



    <!-- http://example.org/uczelnia#Algorytmy -->

    <owl:NamedIndividual rdf:about="http://example.org/uczelnia#Algorytmy">
        <rdf:type rdf:resource="http://example.org/uczelnia#KursObowiazkowy"/>
        <wymagaKursu rdf:resource="http://example.org/uczelnia#Programowanie"/>
        <naWydziale rdf:resource="http://example.org/uczelnia#WI"/>
        <ects rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</ects>
        <rdfs:label xml:lang="pl">Algorytmy i struktury danych</rdfs:label>
    </owl:NamedIndividual>


    <!-- http://example.org/uczelnia#Logika -->

    <owl:NamedIndividual rdf:about="http://example.org/uczelnia#Logika">
        <rdf:type rdf:resource="http://example.org/uczelnia#KursObowiazkowy"/>
        <naWydziale rdf:resource="http://example.org/uczelnia#WI"/>
        <ects rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</ects>
        <rdfs:label xml:lang="pl">Logika dla informatyków</rdfs:label>
    </owl:NamedIndividual>


    <!-- http://example.org/uczelnia#Programowanie -->

    <owl:NamedIndividual rdf:about="http://example.org/uczelnia#Programowanie">
        <rdf:type rdf:resource="http://example.org/uczelnia#KursObowiazkowy"/>
        <naWydziale rdf:resource="http://example.org/uczelnia#WI"/>
        <ects rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</ects>
        <rdfs:label xml:lang="pl">Programowanie</rdfs:label>
    </owl:NamedIndividual>


    <!-- http://example.org/uczelnia#ReprezentacjaWiedzy -->

    <owl:NamedIndividual rdf:about="http://example.org/uczelnia#ReprezentacjaWiedzy">
        <rdf:type rdf:resource="http://example.org/uczelnia#KursObieralny"/>
        <wymagaKursu rdf:resource="http://example.org/uczelnia#SztucznaInteligencja"/>
        <naWydziale rdf:resource="http://example.org/uczelnia#WI"/>
        <ects rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</ects>
        <rdfs:label xml:lang="pl">Metody reprezentacji wiedzy</rdfs:label>
    </owl:NamedIndividual>


    <!-- http://example.org/uczelnia#SztucznaInteligencja -->

    <owl:NamedIndividual rdf:about="http://example.org/uczelnia#SztucznaInteligencja">
        <rdf:type rdf:resource="http://example.org/uczelnia#KursObowiazkowy"/>
        <wymagaKursu rdf:resource="http://example.org/uczelnia#Algorytmy"/>
        <wymagaKursu rdf:resource="http://example.org/uczelnia#Logika"/>
        <naWydziale rdf:resource="http://example.org/uczelnia#WI"/>
        <ects rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</ects>
        <rdfs:label xml:lang="pl">Sztuczna inteligencja</rdfs:label>
    </owl:NamedIndividual>


    <!-- http://example.org/uczelnia#WI -->

    <owl:NamedIndividual rdf:about="http://example.org/uczelnia#WI">
        <rdf:type rdf:resource="http://example.org/uczelnia#Wydzial"/>
        <rdfs:label xml:lang="pl">Wydział Informatyki</rdfs:label>
    </owl:NamedIndividual>


    <!-- http://example.org/uczelnia#p01 -->

    <owl:NamedIndividual rdf:about="http://example.org/uczelnia#p01">
        <rdf:type rdf:resource="http://example.org/uczelnia#Pracownik"/>
        <naWydziale rdf:resource="http://example.org/uczelnia#WI"/>
        <prowadzi rdf:resource="http://example.org/uczelnia#ReprezentacjaWiedzy"/>
        <prowadzi rdf:resource="http://example.org/uczelnia#SztucznaInteligencja"/>
        <imie rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anna</imie>
        <nazwisko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kowalska</nazwisko>
    </owl:NamedIndividual>


    <!-- http://example.org/uczelnia#p04 -->

    <owl:NamedIndividual rdf:about="http://example.org/uczelnia#p04">
        <rdf:type rdf:resource="http://example.org/uczelnia#Pracownik"/>
        <naWydziale rdf:resource="http://example.org/uczelnia#WI"/>
        <imie rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Barbara</imie>
        <nazwisko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wójcik</nazwisko>
    </owl:NamedIndividual>


    <!-- http://example.org/uczelnia#p05 -->

    <owl:NamedIndividual rdf:about="http://example.org/uczelnia#p05">
        <prowadzi rdf:resource="http://example.org/uczelnia#Logika"/>
        <imie rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tomasz</imie>
        <nazwisko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kamiński</nazwisko>
    </owl:NamedIndividual>


    <!-- http://example.org/uczelnia#pd01 -->

    <owl:NamedIndividual rdf:about="http://example.org/uczelnia#pd01">
        <rdf:type rdf:resource="http://example.org/uczelnia#PracaDyplomowa"/>
        <autor rdf:resource="http://example.org/uczelnia#s01"/>
        <promotor rdf:resource="http://example.org/uczelnia#p01"/>
        <rdfs:label xml:lang="pl">Ontologia planu studiów w OWL</rdfs:label>
    </owl:NamedIndividual>


    <!-- http://example.org/uczelnia#s01 -->

    <owl:NamedIndividual rdf:about="http://example.org/uczelnia#s01">
        <rdf:type rdf:resource="http://example.org/uczelnia#Student"/>
        <zaliczyl rdf:resource="http://example.org/uczelnia#Algorytmy"/>
        <zaliczyl rdf:resource="http://example.org/uczelnia#Logika"/>
        <zaliczyl rdf:resource="http://example.org/uczelnia#Programowanie"/>
        <zaliczyl rdf:resource="http://example.org/uczelnia#SztucznaInteligencja"/>
        <zapisanyNa rdf:resource="http://example.org/uczelnia#ReprezentacjaWiedzy"/>
        <imie rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jan</imie>
        <nazwisko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wiśniewski</nazwisko>
        <rokStudiow rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</rokStudiow>
    </owl:NamedIndividual>


    <!-- http://example.org/uczelnia#s04 -->

    <owl:NamedIndividual rdf:about="http://example.org/uczelnia#s04">
        <rdf:type rdf:resource="http://example.org/uczelnia#Student"/>
        <zaliczyl rdf:resource="http://example.org/uczelnia#Programowanie"/>
        <zapisanyNa rdf:resource="http://example.org/uczelnia#ReprezentacjaWiedzy"/>
        <imie rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agnieszka</imie>
        <nazwisko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jankowska</nazwisko>
        <rokStudiow rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</rokStudiow>
    </owl:NamedIndividual>
</rdf:RDF>
