    p:wystepujeW p:Mokradla,
        p:WodySrodladowe ;
    p:zywiSie p:DrobneSsaki,
        p:Plazy,
        p:Ryby ;
    skos:altLabel "czapla"@pl ;
    skos:exactMatch wd:Q25273 .

p:czasObserwacji a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "czas obserwacji"@pl ;
    rdfs:domain p:Obserwacja ;
    rdfs:range xsd:dateTime .

