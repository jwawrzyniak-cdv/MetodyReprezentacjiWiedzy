@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p: <http://example.org/ptaki#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/ptaki> a owl:Ontology ;
    rdfs:label "Ptaki Polski: gatunki i obserwacje"@pl ;
    owl:versionInfo "1.0" .

p:GatunekLegowyWPolsce a owl:Class ;
    rdfs:label "gatunek lęgowy w Polsce"@pl ;
    rdfs:comment "Gatunek, który regularnie gniazduje w Polsce."@pl ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( p:Gatunek [ a owl:Restriction ;
                        owl:onProperty p:maStatusPobytu ;
                        owl:someValuesFrom p:StatusLegowy ] ) ] .

p:GatunekObecnyZima a owl:Class ;
    rdfs:label "gatunek obecny zimą"@pl ;
    rdfs:comment "Gatunek, który regularnie przebywa w Polsce zimą."@pl ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( p:Gatunek [ a owl:Restriction ;
                        owl:onProperty p:maStatusPobytu ;
                        owl:someValuesFrom p:StatusZimowy ] ) ] .

p:GatunekPolujacyNaKregowce a owl:Class ;
    rdfs:label "gatunek polujący na kręgowce"@pl ;
    rdfs:comment "Gatunek, którego pokarm obejmuje kręgowce."@pl ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( p:Gatunek [ a owl:Restriction ;
                        owl:onProperty p:zywiSie ;
                        owl:someValuesFrom p:PokarmKregowy ] ) ] .

p:GatunekZagrozony a owl:Class ;
    rdfs:label "gatunek globalnie zagrożony"@pl ;
    rdfs:comment "Gatunek w kategorii VU, EN lub CR według IUCN."@pl ;
    rdfs:subClassOf p:GatunekOWrazliwejLokalizacji ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( p:Gatunek [ a owl:Restriction ;
                        owl:onProperty p:maKategorieIUCN ;
                        owl:someValuesFrom p:KategoriaZagrozenia ] ) ] .

p:GatunekZwiazanyZWoda a owl:Class ;
    rdfs:label "gatunek związany z wodą"@pl ;
    rdfs:comment "Gatunek, który ma wśród siedlisk wody lub mokradła."@pl ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( p:Gatunek [ a owl:Restriction ;
                        owl:onProperty p:wystepujeW ;
                        owl:someValuesFrom p:SiedliskoWodne ] ) ] .

p:ObserwacjaGatunkuWrazliwego a owl:Class ;
    rdfs:label "obserwacja gatunku wrażliwego"@pl ;
    rdfs:comment "Obserwacja gatunku o wrażliwej lokalizacji."@pl ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( p:Obserwacja [ a owl:Restriction ;
                        owl:onProperty p:dotyczyGatunku ;
                        owl:someValuesFrom p:GatunekOWrazliwejLokalizacji ] ) ] .

p:ObserwacjaLegowa a owl:Class ;
    rdfs:label "obserwacja lęgowa"@pl ;
    rdfs:comment "Obserwacja, w której odnotowano zachowanie lęgowe."@pl ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( p:Obserwacja [ a owl:Restriction ;
                        owl:onProperty p:wykazanoZachowanie ;
                        owl:someValuesFrom p:ZachowanieLegowe ] ) ] .

p:PtakDrapiezny a owl:Class ;
    rdfs:label "ptak drapieżny"@pl ;
    rdfs:comment "Gatunek z rzędu ptaków drapieżnych."@pl ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( p:Gatunek [ a owl:Restriction ;
                        owl:onProperty p:nalezyDoRzedu ;
                        owl:someValuesFrom p:RzadPtakowDrapieznych ] ) ] .

p:bazant a p:Gatunek,
        owl:NamedIndividual ;
    rdfs:label "bażant"@pl ;
    p:maBarwe p:Brazowy,
        p:Czerwony,
        p:Rudy,
        p:Zielony ;
    p:maKategorieIUCN p:LC ;
    p:maRozmiar p:BardzoDuzy ;
    p:maStatusPobytu p:Osiadly ;
    p:nalezyDoRodziny p:Phasianidae ;
    p:nazwaNaukowa "Phasianus colchicus" ;
    p:wystepujeW p:TerenOtwarty ;
    p:zywiSie p:Nasiona,
        p:Owady,
        p:RoslinyZielone ;
    skos:altLabel "bażant zwyczajny"@pl ;
    skos:exactMatch wd:Q25432 .

p:czapla_siwa a p:Gatunek,
        owl:NamedIndividual ;
    rdfs:label "czapla siwa"@pl ;
    p:maBarwe p:Bialy,
