p:obserwowalGatunek a owl:ObjectProperty ;
    rdfs:label "obserwował gatunek"@pl ;
    rdfs:domain p:Obserwator ;
    rdfs:range p:Gatunek ;
    owl:propertyChainAxiom ( p:zglosil p:dotyczyGatunku ) .

p:pliszka_siwa a p:Gatunek,
        owl:NamedIndividual ;
    rdfs:label "pliszka siwa"@pl ;
    p:maBarwe p:Bialy,
        p:Czarny,
        p:Szary ;
    p:maKategorieIUCN p:LC ;
    p:maRozmiar p:Sredni ;
    p:maStatusPobytu p:Wedrowny ;
    p:nalezyDoRodziny p:Motacillidae ;
    p:nazwaNaukowa "Motacilla alba" ;
    p:wystepujeW p:Miasto,
        p:TerenOtwarty,
        p:WodySrodladowe ;
    p:zywiSie p:Owady ;
    skos:altLabel "pliszka"@pl ;
    skos:exactMatch wd:Q25399 .

p:powodWeryfikacji a owl:DatatypeProperty ;
    rdfs:label "powód weryfikacji"@pl ;
    rdfs:domain p:Obserwacja ;
    rdfs:range xsd:string .

