p:liczbaOsobnikow a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "liczba osobników"@pl ;
    rdfs:domain p:Obserwacja ;
    rdfs:range xsd:positiveInteger .

p:liczbaZweryfikowanychZgloszen a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "liczba wcześniej zweryfikowanych zgłoszeń"@pl ;
    rdfs:domain p:Obserwator ;
    rdfs:range xsd:nonNegativeInteger .

p:lokalizacjaPubliczna a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "lokalizacja publiczna"@pl ;
    rdfs:comment "Kwadrat albo blok 5 na 5 km, który wolno opublikować. Wynik reguł z sekcji 8."@pl ;
    rdfs:domain p:Obserwacja ;
    rdfs:range xsd:string .

p:maBarwe a owl:ObjectProperty ;
    rdfs:label "ma barwę"@pl ;
    rdfs:domain p:Gatunek ;
    rdfs:range p:Barwa .

p:maRozmiar a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "ma wielkość"@pl ;
    rdfs:domain p:Gatunek ;
    rdfs:range p:KlasaRozmiaru .

p:maSiedlisko a owl:ObjectProperty ;
    rdfs:label "ma siedlisko"@pl ;
    rdfs:domain p:Kwadrat ;
    rdfs:range p:Siedlisko .

p:mazurek a p:Gatunek,
