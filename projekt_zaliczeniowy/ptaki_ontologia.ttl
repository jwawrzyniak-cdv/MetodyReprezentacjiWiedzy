    rdfs:comment "Gatunek ptaka jako całość. Jego cechy opisują typowego dorosłego przedstawiciela, nie konkretnego osobnika."@pl .

[] a owl:AllDifferent ;
    owl:distinctMembers ( p:Maly p:Sredni p:Duzy p:BardzoDuzy ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( p:LC p:NT p:VU p:EN p:CR ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( p:Osiadly p:CzesciowoWedrowny p:Wedrowny p:GoscZimowy ) .

[] a owl:AllDisjointClasses ;
    owl:members ( p:Gatunek p:Rodzina p:Rzad p:Siedlisko p:Pokarm p:StatusPobytu p:KategoriaIUCN p:KlasaRozmiaru p:Barwa p:Obserwator p:Kwadrat p:Obserwacja p:Zachowanie ) .

